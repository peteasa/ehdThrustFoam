FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

angle           12;

magnitude       40.0; // I 0.05 ; k 6.0 ; omega 1.49e3

radAngle        #calc "degToRad($angle)";
UField          uniform ( #calc "$magnitude*cos($radAngle)" #calc "$magnitude*sin($radAngle)" 0 );

internalField   $UField;

boundaryField
{
    INLET
    {
        type            freestreamVelocity;
        freestreamValue $UField;
    }

    OUTLET
    {
        type inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }

    WALL
    {
        type            slip;
    }

    PELEMENT
    {
        type            noSlip;
    }

    NELEMENT
    {
        type            noSlip;
    }

    frontAndBackPlanes
    {
        type            empty;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

